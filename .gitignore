/target
# Side build directories, so two builds can run at once without the linker
# fighting over one exe (CARGO_TARGET_DIR=target-budget, target-dev, ...).
/target-*
# Scenes are scratch output, except where they are content: the committed
# examples, the module fragments the openUC2 catalogue serves to the browser
# (without these the catalogue loads but every module reports missing optics),
# the schema fixtures a test `include_str!`s (without these the test does not
# compile), and the 3D-preview demos the slice3d Playwright spec opens.
*.ocanvas
!examples/**/*.ocanvas
!web/public/catalog/**/*.ocanvas
!web/public/demo-*.ocanvas
!web/public/gallery/*.ocanvas
!crates/*/tests/data/**/*.ocanvas
# The fidelity bench scenes; the heliostat light pipe is 12 MB and is written
# on demand (see bench_throughput3.rs).
!crates/oc-trace/examples/bench-scenes/*.ocanvas
crates/oc-trace/examples/bench-scenes/heliostat-light-pipe.ocanvas

# web shell
web/node_modules
web/pkg
web/dist

# browser test output
web/test-results
web/playwright-report
web/.playwright

# python (oc-py bindings)
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/
crates/oc-py/build/
crates/oc-py/dist/

# OS / editor cruft
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# Downloaded source data the examples rebuild from (see each script).
examples/**/.cache/
