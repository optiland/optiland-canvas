/target
# Scenes are scratch output, except where they are content: the committed
# examples, and the module fragments the openUC2 catalogue serves to the browser
# (without these the catalogue loads but every module reports missing optics).
*.ocanvas
!examples/**/*.ocanvas
!web/public/catalog/**/*.ocanvas

# web shell
web/node_modules
web/pkg
web/dist

# browser test output
web/test-results
web/playwright-report
web/.playwright

# python (oc-py bindings)
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/
crates/oc-py/build/
crates/oc-py/dist/

# OS / editor cruft
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

